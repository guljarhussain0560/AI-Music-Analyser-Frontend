# Frontend Application URL
# Used for frontend-side routing and API references
# Local development: http://localhost:5173
# Production: your-domain.com
VITE_FRONTEND_URL=http://localhost:5173

# Backend API Server URL
# Points to your FastAPI backend server
# Local development: http://127.0.0.1:8000 or http://localhost:8000
# Production: https://your-api-domain.com
# Uncomment one of the alternatives below based on your setup
VITE_BACKEND_URL=http://127.0.0.1:8000
# VITE_BACKEND_URL=http://localhost:8080
# VITE_BACKEND_URL=https://music-analyser-424100972099.asia-south1.run.app

# Google OAuth 2.0 Client ID
# Required for Google authentication (Sign In / Sign Up)
# Get this from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials (Web application type)
# 5. Add your frontend URL to "Authorized JavaScript origins"
# 6. Copy the Client ID below
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
